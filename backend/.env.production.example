# Copy to .env.production.local (gitignored) to run migrate/seed from your
# own machine against the production Turso database:
#   npm run migrate:prod
#   npm run seed:prod        creates only the System Admin below
#   npm run db:reset:prod    empties this database first (go-live from UAT; see DEPLOYMENT.md)
# The SEED_ADMIN_* values must be real: the seed refuses placeholders on Turso.
NODE_ENV=production
DATABASE_URL=libsql://winter-league-<your-org>.turso.io
DATABASE_AUTH_TOKEN=<paste token>
SEED_ADMIN_FIRST_NAME=<first name>
SEED_ADMIN_LAST_NAME=<last name>
SEED_ADMIN_EMAIL=you@yourdomain.com
SEED_ADMIN_PASSWORD=<a strong temporary password>
