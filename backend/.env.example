# =====================================================================
# Winter League Platform — backend environment
# Copy to .env for local development:   cp .env.example .env
# =====================================================================

NODE_ENV=development
PORT=4100

# ---- Database ----
# Local development uses a plain SQLite file through libSQL's file: protocol.
# No Turso account is needed to develop locally.
DATABASE_URL=file:./data/winter-league.db
DATABASE_AUTH_TOKEN=
#
# Production (Render) uses the Turso database instead — set these two in the
# Render dashboard, never in a committed file:
#   DATABASE_URL=libsql://winter-league-<your-org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from: turso db tokens create winter-league>

# ---- Auth ----
# Production: generate with  openssl rand -hex 32  (must differ from Gym Hive's)
JWT_SECRET=dev-only-change-me-before-deploying
JWT_EXPIRES_IN=8h

# ---- Frontend origin (CORS + links in password-reset emails) ----
# Comma-separate multiple origins if needed (e.g. a Vercel preview URL).
APP_URL=http://localhost:5174

# ---- League rules ----
MAX_PROGRAMS=16
# The league's time zone: game times, "today", referee check-in windows, and
# timestamps all use it. Pacific Time; handles daylight saving automatically.
LEAGUE_TIMEZONE=America/Los_Angeles
# Demo only: let referees check in to any upcoming game, not just on game day.
# Leave false in production.
DEMO_CHECKIN_ANYTIME=false

# ---- First System Admin (used by `npm run seed`) ----
SEED_ADMIN_FIRST_NAME=League
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Email ----
# console = print emails to the server log (local dev)
# brevo   = send through Brevo SMTP (production)
EMAIL_PROVIDER=console
EMAIL_FROM="Winter League <no-reply@example.com>"
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
