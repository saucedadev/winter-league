# Local development: leave blank — Vite proxies /api to http://localhost:4100.
# Production (Vercel): set in the Vercel project's Environment Variables:
#   VITE_API_URL=https://winter-league-api.onrender.com/api
VITE_API_URL=

# ---- Hub Portal single sign-on (PORTAL-SSO.md) ----
# The portal's address, e.g. https://hub-portal.vercel.app (local: http://localhost:5180).
# When set, signed-out visitors are sent to the portal to sign in and come
# straight back, and Sign out returns to the portal. Leave blank to keep
# Winter League's own sign-in screen.
VITE_PORTAL_URL=
# This app's ID in the portal (Admin > Apps).
VITE_PORTAL_APP_SLUG=winter-league
